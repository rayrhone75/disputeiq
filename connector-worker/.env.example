# DisputeIQ connector worker — runs on a VPS / container (NOT Vercel).
PORT=8787
# Shared secret. The Vercel app sends `Authorization: Bearer <this>`.
# Must equal CONNECTOR_WORKER_SECRET in the Vercel environment.
CONNECTOR_WORKER_SECRET=replace-with-a-long-random-secret
# Where step screenshots are written for diagnostics.
DIAGNOSTICS_DIR=./diagnostics
