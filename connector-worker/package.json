{
  "name": "disputeiq-connector-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DisputeIQ credit-monitoring connector worker. Runs Playwright on a VPS/container; Vercel calls this service's API. NEVER deploy to Vercel serverless.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "serve": "node dist/server.js",
    "install-browser": "playwright install chromium"
  },
  "dependencies": {
    "express": "^4.19.2",
    "playwright": "^1.48.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
