generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  SUPPORT
  USER
}

enum ReportSource {
  MANUAL_UPLOAD
  MYFREESCORENOW
}

enum DisputeStatus {
  DRAFT
  NEEDS_USER_CONFIRMATION
  READY_FOR_PAYMENT
  PAID
  MAILED
  DELIVERED
  RESPONSE_RECEIVED
  ESCALATION_READY
  CLOSED
}

enum LetterType {
  FACTUAL_DISPUTE
  MOV_REQUEST
  DIRECT_FURNISHER
  IDENTITY_THEFT_605B
  CFPB_PACKET
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum ShadowStrikeProvider {
  LEXISNEXIS
  INNOVIS
  SAGESTREAM
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  role         UserRole @default(USER)
  isGraceUser  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile              UserProfile?
  reports              CreditReport[]
  disputes             DisputeCase[]
  payments             PaymentIntent[]
  consentReceipts      ConsentReceipt[]
  auditLogs            AuditLog[]            @relation("AuditTarget")
  actorLogs            AuditLog[]            @relation("AuditActor")
  shadowStrikeRequests ShadowStrikeRequest[]
}

model UserProfile {
  id                String @id @default(cuid())
  userId            String @unique
  fullName          String
  encryptedDob      String
  encryptedSsnLast4 String
  encryptedAddress1 String
  encryptedCity     String
  encryptedState    String
  encryptedZip      String
  encryptedPhone    String?
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ConsentReceipt {
  id          String   @id @default(cuid())
  userId      String
  consentType String
  version     String
  acceptedAt  DateTime @default(now())
  ipAddress   String?
  userAgent   String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreditReport {
  id           String       @id @default(cuid())
  userId       String
  source       ReportSource
  externalRef  String?
  pulledAt     DateTime
  snapshotHash String
  rawSecureRef String?
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradelines   Tradeline[]
}

model Tradeline {
  id               String        @id @default(cuid())
  reportId         String
  bureau           String
  creditorName     String
  accountRefMasked String
  balanceCents     Int?
  pastDueCents     Int?
  statusLabel      String?
  openedAt         DateTime?
  lastReportedAt   DateTime?
  lastActivityAt   DateTime?
  isCollection     Boolean       @default(false)
  isMedical        Boolean       @default(false)
  isFraudClaimed   Boolean       @default(false)
  report           CreditReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  disputes         DisputeCase[]
}

model DisputeCase {
  id                String           @id @default(cuid())
  userId            String
  tradelineId       String?
  status            DisputeStatus    @default(DRAFT)
  letterType        LetterType
  aiReasonSummary   String
  legalBasisSummary String?
  userConfirmedAt   DateTime?
  responseDueAt     DateTime?
  mailedAt          DateTime?
  deliveredAt       DateTime?
  secureLetterRef   String?
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradeline         Tradeline?       @relation(fields: [tradelineId], references: [id])
  attachments       CaseAttachment[]
  payments          PaymentIntent[]
  mailJobs          MailJob[]
}

enum MailProvider {
  LETTERSTREAM
}

enum MailJobStatus {
  QUEUED
  SUBMITTED
  ACCEPTED
  PRINTED
  MAILED
  DELIVERED
  FAILED
}

model MailJob {
  id              String        @id @default(cuid())
  disputeCaseId   String
  provider        MailProvider  @default(LETTERSTREAM)
  providerJobId   String?       @unique
  trackingCode    String?       // USPS tracking number once available
  signatureRef    String?       // storage ref for return-receipt signature image
  mode            String        // "test" | "production"
  certified       Boolean       @default(true)
  err             Boolean       @default(true)
  status          MailJobStatus @default(QUEUED)
  attempts        Int           @default(0)
  lastError       String?
  rawResponseJson Json?
  costCents       Int?
  submittedAt     DateTime?
  mailedAt        DateTime?
  deliveredAt     DateTime?
  signedAt        DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  disputeCase DisputeCase    @relation(fields: [disputeCaseId], references: [id], onDelete: Cascade)
  events      MailJobEvent[]
}

// Append-only history of every LetterStream event for a mail job.
// Feeds the user timeline and the admin inspection view.
model MailJobEvent {
  id           String         @id @default(cuid())
  mailJobId    String
  kind         String         // "SUBMIT" | "STATUS" | "SCAN" | "SIGNATURE" | "ERROR" | "RETRY"
  rawStatus    String?
  mappedStatus MailJobStatus?
  message      String?
  payloadJson  Json?
  occurredAt   DateTime       @default(now())

  mailJob MailJob @relation(fields: [mailJobId], references: [id], onDelete: Cascade)

  @@index([mailJobId, occurredAt])
}

model CaseAttachment {
  id            String      @id @default(cuid())
  disputeCaseId String
  kind          String
  secureFileRef String
  createdAt     DateTime    @default(now())
  disputeCase   DisputeCase @relation(fields: [disputeCaseId], references: [id], onDelete: Cascade)
}

model PaymentIntent {
  id                String        @id @default(cuid())
  userId            String
  disputeCaseId     String?
  provider          String
  providerPaymentId String?       @unique
  amountCents       Int
  currency          String        @default("USD")
  status            PaymentStatus @default(PENDING)
  description       String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  disputeCase       DisputeCase?  @relation(fields: [disputeCaseId], references: [id])
}

model ShadowStrikeRequest {
  id              String               @id @default(cuid())
  userId          String
  provider        ShadowStrikeProvider
  status          String
  confirmationRef String?
  submittedAt     DateTime?
  lastError       String?
  createdAt       DateTime             @default(now())
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id           String   @id @default(cuid())
  targetUserId String?
  actorUserId  String?
  action       String
  entityType   String
  entityId     String
  metadataJson Json
  createdAt    DateTime @default(now())

  targetUser User? @relation("AuditTarget", fields: [targetUserId], references: [id])
  actorUser  User? @relation("AuditActor", fields: [actorUserId], references: [id])
}
