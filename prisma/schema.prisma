generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  SUPPORT
  USER
}

enum ReportSource {
  MANUAL_UPLOAD
  MYFREESCORENOW
  IDENTITYIQ
  MYSCOREIQ
}

enum CreditProvider {
  IDENTITYIQ
  MYSCOREIQ
  MYFREESCORENOW
  MANUAL
}

enum CreditImportStatus {
  PENDING
  FETCHED
  VALIDATED
  NORMALIZED
  FAILED
  ARCHIVED
}

enum CreditReportBureau {
  EXPERIAN
  EQUIFAX
  TRANSUNION
  UNKNOWN
}

enum DisputeCandidateStage {
  ROUND_1
  ROUND_2
  MOV
  DIRECT_FURNISHER
  CFPB
  AG
  STATE_REGULATOR
}

enum DisputeCandidateReason {
  INACCURATE
  INCOMPLETE
  UNVERIFIABLE
  DUPLICATE
  OUTDATED
  IDENTITY_THEFT
  BALANCE_MISMATCH
  STATUS_MISMATCH
  OBSOLETE_BY_AGE
  MEDICAL_UNDER_LIMIT
  OTHER
}

enum DisputeStatus {
  DRAFT
  NEEDS_USER_CONFIRMATION
  READY_FOR_PAYMENT
  PAID
  MAILED
  DELIVERED
  RESPONSE_RECEIVED
  ESCALATION_READY
  CLOSED
}

enum LetterType {
  FACTUAL_DISPUTE
  MOV_REQUEST
  DIRECT_FURNISHER
  IDENTITY_THEFT_605B
  CFPB_PACKET
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum ShadowStrikeProvider {
  LEXISNEXIS
  INNOVIS
  SAGESTREAM
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  role         UserRole @default(USER)
  isGraceUser  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Support archival + PII anonymization. An archived user is excluded from
  // customer-facing surfaces (auth blocked) but remains in the DB so audit
  // history stays intact. A hard purge removes the row entirely; use the
  // dedicated admin endpoint guarded by typed confirmation + reason.
  archivedAt      DateTime?
  archivedReason  String?
  archivedBy      String?
  piiAnonymizedAt DateTime?

  profile              UserProfile?
  subscription         UserSubscription?
  reports              CreditReport[]
  disputes             DisputeCase[]
  payments             PaymentIntent[]
  consentReceipts      ConsentReceipt[]
  auditLogs            AuditLog[]            @relation("AuditTarget")
  actorLogs            AuditLog[]            @relation("AuditActor")
  shadowStrikeRequests ShadowStrikeRequest[]
  creditImports        CreditReportImport[]
  supportNotes         SupportNote[]         @relation("SupportNoteTarget")
  supportNotesAuthored SupportNote[]         @relation("SupportNoteAuthor")
}

model UserProfile {
  id                String  @id @default(cuid())
  userId            String  @unique
  fullName          String
  encryptedDob      String
  encryptedSsnLast4 String
  encryptedAddress1 String
  encryptedCity     String
  encryptedState    String
  encryptedZip      String
  encryptedPhone    String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ConsentReceipt {
  id          String   @id @default(cuid())
  userId      String
  consentType String
  version     String
  acceptedAt  DateTime @default(now())
  ipAddress   String?
  userAgent   String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreditReport {
  id           String       @id @default(cuid())
  userId       String
  source       ReportSource
  externalRef  String?
  pulledAt     DateTime
  snapshotHash String
  rawSecureRef String?
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradelines   Tradeline[]
}

model Tradeline {
  id               String        @id @default(cuid())
  reportId         String
  bureau           String
  creditorName     String
  accountRefMasked String
  balanceCents     Int?
  pastDueCents     Int?
  statusLabel      String?
  openedAt         DateTime?
  lastReportedAt   DateTime?
  lastActivityAt   DateTime?
  isCollection     Boolean       @default(false)
  isMedical        Boolean       @default(false)
  isFraudClaimed   Boolean       @default(false)
  report           CreditReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  disputes         DisputeCase[]
}

model DisputeCase {
  id                String           @id @default(cuid())
  userId            String
  tradelineId       String?
  status            DisputeStatus    @default(DRAFT)
  letterType        LetterType
  aiReasonSummary   String
  legalBasisSummary String?
  userConfirmedAt   DateTime?
  responseDueAt     DateTime?
  mailedAt          DateTime?
  deliveredAt       DateTime?
  secureLetterRef   String?
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradeline         Tradeline?       @relation(fields: [tradelineId], references: [id])
  attachments       CaseAttachment[]
  payments          PaymentIntent[]
  mailJobs          MailJob[]
}

enum MailProvider {
  LETTERSTREAM
}

enum MailJobStatus {
  QUEUED
  SUBMITTED
  ACCEPTED
  PRINTED
  MAILED
  DELIVERED
  FAILED
}

model MailJob {
  id              String        @id @default(cuid())
  disputeCaseId   String
  provider        MailProvider  @default(LETTERSTREAM)
  providerJobId   String?       @unique
  trackingCode    String? // USPS tracking number once available
  signatureRef    String? // storage ref for return-receipt signature image
  mode            String // "test" | "production"
  certified       Boolean       @default(true)
  err             Boolean       @default(true)
  status          MailJobStatus @default(QUEUED)
  attempts        Int           @default(0)
  lastError       String?
  rawResponseJson Json?
  costCents       Int?
  submittedAt     DateTime?
  mailedAt        DateTime?
  deliveredAt     DateTime?
  signedAt        DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  disputeCase DisputeCase    @relation(fields: [disputeCaseId], references: [id], onDelete: Cascade)
  events      MailJobEvent[]
}

// Append-only history of every LetterStream event for a mail job.
// Feeds the user timeline and the admin inspection view.
model MailJobEvent {
  id           String         @id @default(cuid())
  mailJobId    String
  kind         String // "SUBMIT" | "STATUS" | "SCAN" | "SIGNATURE" | "ERROR" | "RETRY"
  rawStatus    String?
  mappedStatus MailJobStatus?
  message      String?
  payloadJson  Json?
  occurredAt   DateTime       @default(now())

  mailJob MailJob @relation(fields: [mailJobId], references: [id], onDelete: Cascade)

  @@index([mailJobId, occurredAt])
}

model CaseAttachment {
  id            String      @id @default(cuid())
  disputeCaseId String
  kind          String
  secureFileRef String
  createdAt     DateTime    @default(now())
  disputeCase   DisputeCase @relation(fields: [disputeCaseId], references: [id], onDelete: Cascade)
}

model PaymentIntent {
  id                String        @id @default(cuid())
  userId            String
  disputeCaseId     String?
  provider          String
  providerPaymentId String?       @unique
  amountCents       Int
  currency          String        @default("USD")
  status            PaymentStatus @default(PENDING)
  description       String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  disputeCase       DisputeCase?  @relation(fields: [disputeCaseId], references: [id])
}

model ShadowStrikeRequest {
  id              String               @id @default(cuid())
  userId          String
  provider        ShadowStrikeProvider
  status          String
  confirmationRef String?
  submittedAt     DateTime?
  lastError       String?
  createdAt       DateTime             @default(now())
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSubscription {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  planCode                String // "starter" | "pro" | "elite"
  status                  String   @default("active") // "active" | "past_due" | "canceled" | "trialing"
  cycleStart              DateTime @default(now())
  cycleEnd                DateTime
  includedPackets         Int
  overagePacketPriceCents Int      @default(1995)
  squareSubscriptionId    String? // Square subscription reference if applicable
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Lead {
  id           String   @id @default(cuid())
  email        String
  fullName     String?
  phone        String?
  source       String // "homepage" | "seo:<slug>" | "pricing" | "blog" | etc
  topic        String? // SEO topic when applicable
  referralCode String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  ipHash       String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([email])
  @@index([source])
}

model Referral {
  id          String   @id @default(cuid())
  code        String   @unique
  ownerUserId String?
  clicks      Int      @default(0)
  signups     Int      @default(0)
  conversions Int      @default(0)
  rewardCents Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([ownerUserId])
}

model AuditLog {
  id           String   @id @default(cuid())
  targetUserId String?
  actorUserId  String?
  action       String
  entityType   String
  entityId     String
  metadataJson Json
  createdAt    DateTime @default(now())

  targetUser User? @relation("AuditTarget", fields: [targetUserId], references: [id])
  actorUser  User? @relation("AuditActor", fields: [actorUserId], references: [id])
}

// Admin-managed key/value configuration. Used today to store the active
// IDIQ affiliate URL, display labels, onboarding copy, and feature flags
// so changing those values doesn't require a code change.
model PlatformSetting {
  key       String   @id
  valueJson Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// Internal support notes attached to a customer. Staff-only today;
// `isInternal` reserved so a future "share with customer" surface can flip
// individual notes without a schema change.
model SupportNote {
  id           String   @id @default(cuid())
  userId       String
  authorUserId String?
  body         String
  category     String   @default("general") // general / billing / report / escalation
  isInternal   Boolean  @default(true)
  pinned       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User  @relation("SupportNoteTarget", fields: [userId], references: [id], onDelete: Cascade)
  author User? @relation("SupportNoteAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

// ────────────────────────────────────────────────────────────────────────────
// Credit report import pipeline
//
// Additive models for the IdentityIQ / MyScoreIQ JSON ingestion path.
// Design rules:
//   - Raw provider JSON is encrypted at rest and replayable.
//   - Normalization is idempotent: re-running against the same raw capture
//     must converge on the same normalized rows.
//   - No information is dropped; anything the schema does not cover is
//     preserved in `unmappedFieldsJson` for later review.
//   - Existing CreditReport/Tradeline models remain untouched; this pipeline
//     writes alongside them and optionally links to a CreditReport.
// ────────────────────────────────────────────────────────────────────────────

model CreditReportImport {
  id              String               @id @default(cuid())
  userId          String
  provider        CreditProvider
  providerRef     String? // external customer/session id from provider
  sourceUrl       String? // e.g. the CreditReport.aspx?view=json URL
  status          CreditImportStatus   @default(PENDING)
  fetchedAt       DateTime?
  validatedAt     DateTime?
  normalizedAt    DateTime?
  schemaVersion   String               @default("v1")
  parserVersion   String               @default("v1")
  payloadHash     String? // sha256 of raw JSON — dedupe re-imports
  bureauCoverage  CreditReportBureau[] @default([])
  errorCode       String?
  errorMessage    String?
  errorDetailJson Json?
  linkedReportId  String? // optional link back to CreditReport
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  raw               CreditReportRaw?
  normalized        CreditReportNormalized?
  tradelines        CreditTradeline[]
  inquiries         CreditInquiry[]
  collections       CreditCollection[]
  publicRecords     CreditPublicRecord[]
  scoreSnapshots    CreditScoreSnapshot[]
  personalProfiles  CreditPersonalProfile[]
  disputeCandidates CreditDisputeCandidate[]

  @@index([userId, status])
  @@index([provider, providerRef])
  @@index([payloadHash])
}

// Encrypted raw capture. Stored in Postgres for small payloads plus an
// optional secure-storage ref for large ones.
model CreditReportRaw {
  id                   String   @id @default(cuid())
  importId             String   @unique
  encryptedPayload     String // AES-256-GCM base64 (lib/encryption.ts)
  payloadBytes         Int      @default(0)
  contentEncoding      String   @default("application/json")
  payloadHash          String // sha256 of plaintext — matches import.payloadHash
  secureStorageRef     String? // optional R2/S3 ref for large blobs
  capturedAt           DateTime @default(now())
  redactionFingerprint String? // hash of PII-redacted payload, for log comparison

  import CreditReportImport @relation(fields: [importId], references: [id], onDelete: Cascade)
}

// The "clean" projection — one row per import. Consumers read from this
// plus the child tables below, never from raw.
model CreditReportNormalized {
  id                 String               @id @default(cuid())
  importId           String               @unique
  pulledAt           DateTime
  reportIdProvider   String? // provider's report identifier if present
  bureaus            CreditReportBureau[] @default([])
  summaryJson        Json // e.g. totals by bureau: open accounts, balances, utilization
  unmappedFieldsJson Json? // anything the mapper did not recognize
  validationWarnings String[]             @default([])
  createdAt          DateTime             @default(now())

  import CreditReportImport @relation(fields: [importId], references: [id], onDelete: Cascade)
}

model CreditPersonalProfile {
  id                   String             @id @default(cuid())
  importId             String
  bureau               CreditReportBureau @default(UNKNOWN)
  fullName             String?
  encryptedDob         String? // never plaintext
  encryptedSsnLast4    String? // last4 only — full SSN forbidden
  encryptedPrimaryAddr String?
  cityMasked           String?
  stateCode            String?
  zipMasked            String? // "902••"
  phoneMasked          String? // "(•••) •••-1234"
  employers            Json? // array of { name, position, reportedAt }
  priorAddresses       Json? // array of { line1, city, state, zip }
  aliases              String[]           @default([])
  fraudAlerts          Json? // array of { type, postedAt, expiresAt, phone }
  consumerStatement    String? // 100-word statement if present
  unmappedFieldsJson   Json?
  createdAt            DateTime           @default(now())

  import CreditReportImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId, bureau])
}

model CreditTradeline {
  id                  String             @id @default(cuid())
  importId            String
  bureau              CreditReportBureau
  fingerprint         String // stable hash: creditor+account+bureau
  creditorName        String
  furnisherName       String?
  accountRefMasked    String
  accountType         String?
  accountSubtype      String?
  ownership           String? // individual / joint / authorized user
  balanceCents        Int?
  highBalanceCents    Int?
  creditLimitCents    Int?
  pastDueCents        Int?
  monthlyPaymentCents Int?
  termsMonths         Int?
  statusLabel         String?
  paymentStatus       String?
  rawStatus           String?
  openedAt            DateTime?
  closedAt            DateTime?
  lastReportedAt      DateTime?
  lastActivityAt      DateTime?
  lastPaymentAt       DateTime?
  isCollection        Boolean            @default(false)
  isChargeOff         Boolean            @default(false)
  isMedical           Boolean            @default(false)
  isDerogatory        Boolean            @default(false)
  isClosed            Boolean            @default(false)
  isFraudClaimed      Boolean            @default(false)
  paymentHistoryJson  Json? // array of { month, code }
  remarks             String[]           @default([])
  disputeFlags        String[]           @default([])
  unmappedFieldsJson  Json?
  createdAt           DateTime           @default(now())

  import            CreditReportImport       @relation(fields: [importId], references: [id], onDelete: Cascade)
  disputeCandidates CreditDisputeCandidate[]

  @@index([importId, bureau])
  @@index([fingerprint])
}

model CreditInquiry {
  id                 String             @id @default(cuid())
  importId           String
  bureau             CreditReportBureau
  inquirerName       String
  inquirerType       String? // e.g. credit card, auto, mortgage
  inquiryDate        DateTime?
  isHard             Boolean            @default(true)
  purpose            String?
  unmappedFieldsJson Json?
  createdAt          DateTime           @default(now())

  import CreditReportImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId, bureau])
}

model CreditCollection {
  id                   String             @id @default(cuid())
  importId             String
  bureau               CreditReportBureau
  collectorName        String
  originalCreditor     String?
  accountRefMasked     String
  balanceCents         Int?
  originalBalanceCents Int?
  statusLabel          String?
  assignedAt           DateTime?
  reportedAt           DateTime?
  firstDelinquencyAt   DateTime?
  isMedical            Boolean            @default(false)
  unmappedFieldsJson   Json?
  createdAt            DateTime           @default(now())

  import CreditReportImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId, bureau])
}

model CreditPublicRecord {
  id                 String             @id @default(cuid())
  importId           String
  bureau             CreditReportBureau
  recordType         String // bankruptcy / judgment / lien
  status             String?
  courtName          String?
  referenceNumber    String?
  filedAt            DateTime?
  resolvedAt         DateTime?
  amountCents        Int?
  unmappedFieldsJson Json?
  createdAt          DateTime           @default(now())

  import CreditReportImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId, bureau])
}

model CreditScoreSnapshot {
  id         String             @id @default(cuid())
  importId   String
  bureau     CreditReportBureau
  scoreModel String // e.g. "FICO 8", "VantageScore 3.0"
  score      Int
  rangeMin   Int?
  rangeMax   Int?
  factors    String[]           @default([])
  pulledAt   DateTime?
  createdAt  DateTime           @default(now())

  import CreditReportImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId, bureau])
}

// Output of the dispute engine — one row per bureau per reason per target.
// These are *candidates*, not DisputeCase rows; promoting a candidate into
// a DisputeCase is an explicit later action.
model CreditDisputeCandidate {
  id             String                 @id @default(cuid())
  importId       String
  tradelineId    String?
  bureau         CreditReportBureau
  stage          DisputeCandidateStage  @default(ROUND_1)
  reason         DisputeCandidateReason
  reasonCodes    String[]               @default([])
  severity       String                 @default("medium") // low / medium / high
  summary        String
  evidenceJson   Json // structured facts the engine used
  legalBasis     String[]               @default([]) // e.g. ["FCRA 611", "FCRA 623"]
  confidence     String                 @default("medium") // low / medium / high
  promotedCaseId String? // DisputeCase id once promoted
  createdAt      DateTime               @default(now())

  import    CreditReportImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  tradeline CreditTradeline?   @relation(fields: [tradelineId], references: [id], onDelete: SetNull)

  @@index([importId, bureau])
  @@index([tradelineId])
}
