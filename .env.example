# Convex (active database) — pulled from `npx convex dev` / `npx convex deploy`
NEXT_PUBLIC_CONVEX_URL=https://<your-deployment>.convex.cloud
CONVEX_DEPLOYMENT=dev:<your-deployment>

# Clerk auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Brand
NEXT_PUBLIC_BRAND_NAME=DisputeIQ
NEXT_PUBLIC_APP_TITLE="DisputeIQ Portal"
NEXT_PUBLIC_ADMIN_TITLE="DisputeIQ Command Center"
SUPPORT_EMAIL=support@disputeiq.org

# Brand + domain configuration (single-domain on disputeiq.org)
APP_BASE_URL=https://disputeiq.org
MARKETING_BASE_URL=https://disputeiq.org
NEXT_PUBLIC_APP_URL=https://disputeiq.org
NEXT_PUBLIC_MARKETING_URL=https://disputeiq.org
ADMIN_BASE_URL=https://disputeiq.org/admin
API_BASE_URL=https://disputeiq.org/api

ENCRYPTION_KEY=replace-me-at-least-32-characters-long

# Mistral — powers credit-report processing (OCR for PDFs + paralegal
# LLM that extracts structured JSON). The upload-any / paste /
# extension-import routes refuse to run without this set; the preflight
# in app/api/reports/upload-any/route.ts returns a clear error otherwise.
MISTRAL_API_KEY=
# Optional override; default is mistral-large-latest.
# MISTRAL_PARALEGAL_MODEL=mistral-large-latest

# ── Credit Monitoring Connectors (credential-based auto-import) ────────
# Playwright runs in the SEPARATE connector-worker/ service (VPS/container),
# never on Vercel. Vercel calls the worker over HTTPS. See connector-worker/.
#
# Master + per-provider switches (all default "false"):
FEATURE_CREDIT_CONNECTORS=false
FEATURE_MYSCOREIQ_CONNECTOR=false
FEATURE_MYFREESCORENOW_CONNECTOR=false
#
# Connector worker (must match the worker's own env):
CONNECTOR_WORKER_URL=https://connect.your-host.com
CONNECTOR_WORKER_SECRET=replace-with-a-long-random-secret
#
# AES-256-GCM key (>=32 chars) protecting stored provider logins when a
# customer checks "remember login". Distinct from ENCRYPTION_KEY.
CREDIT_CONNECTOR_VAULT_KEY=replace-me-at-least-32-characters-long
# AES-256-GCM key (>=32 chars) for connector report drafts. Falls back to
# ENCRYPTION_KEY if unset.
CREDIT_REPORT_ENCRYPTION_KEY=replace-me-at-least-32-characters-long

# Anthropic AI
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_DRAFT_MODEL=claude-opus-4-6
ANTHROPIC_ASSIST_MODEL=claude-haiku-4-5

# Stripe — primary payment provider (subscriptions + one-time packet charges)
STRIPE_SECRET_KEY=sk_test_...
# Comes from the `stripe listen` CLI output during local dev; for production
# use the signing secret on the Stripe Dashboard webhook endpoint config.
STRIPE_WEBHOOK_SECRET=whsec_...
# Recurring Price IDs — create three monthly prices in Stripe and paste here
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ELITE=price_...

# Square — LEGACY, retained only so any leftover webhook config 410s cleanly.
# Not used by the live flow; safe to leave blank.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_API_BASE=https://connect.squareup.com
SQUARE_PLAN_VARIATION_STARTER=
SQUARE_PLAN_VARIATION_PRO=
SQUARE_PLAN_VARIATION_ELITE=

# LetterStream — Monetization Mode (master account)
LETTERSTREAM_API_ID=
LETTERSTREAM_API_KEY=
LETTERSTREAM_API_BASE=https://www.letterstream.com/apis/index.php
# test = jobs submitted but not auto-approved | production = real mail
LETTERSTREAM_MODE=production
LETTERSTREAM_CALLBACK_URL=https://disputeiq.org/api/webhooks/letterstream
# Optional shared-secret echoed back in the callback `key` field
LETTERSTREAM_CALLBACK_KEY=
# batch (Method 1 ZIP, default) | single (Method 2 single_file fallback)
LETTERSTREAM_SUBMIT_METHOD=batch

# MyScoreIQ — primary credit-report provider for new customers
MYSCOREIQ_AFFILIATE_URL=https://member.myscoreiq.com/get-fico-preferred.aspx?offercode=43214399
MYSCOREIQ_JSON_REPORT_URL=https://member.myscoreiq.com/CreditReport.aspx?view=json
MYSCOREIQ_DISPLAY_NAME=MyScoreIQ

# IdentityIQ — legacy admin/support only; not advertised to new customers.
IDIQ_AFFILIATE_URL=
IDIQ_STAGE_URL=

# MyFreeScoreNow — retired; vars kept only so legacy callbacks continue to 410.
MFSN_API_KEY=
MFSN_AFFILIATE_LINK=
MFSN_CALLBACK_URL=https://disputeiq.org/api/mfsn/callback

# Cloudflare R2 (S3-compatible)
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com

OCR_API_KEY=
