DATABASE_URL=postgresql://user:pass@localhost:5432/disputeiq
NEXTAUTH_SECRET=replace-me-at-least-32-characters-long

# Brand
NEXT_PUBLIC_BRAND_NAME=DisputeIQ
NEXT_PUBLIC_APP_TITLE="DisputeIQ Portal"
NEXT_PUBLIC_ADMIN_TITLE="DisputeIQ Command Center"
SUPPORT_EMAIL=support@disputeiq.org

# Brand + domain configuration
APP_BASE_URL=https://app.disputeiq.org
MARKETING_BASE_URL=https://disputeiq.org
NEXT_PUBLIC_APP_URL=https://app.disputeiq.org
NEXT_PUBLIC_MARKETING_URL=https://disputeiq.org
# Optional: reserved for future separation
ADMIN_BASE_URL=https://admin.disputeiq.org
API_BASE_URL=https://api.disputeiq.org

ENCRYPTION_KEY=replace-me-at-least-32-characters-long

# Anthropic AI
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_DRAFT_MODEL=claude-opus-4-6
ANTHROPIC_ASSIST_MODEL=claude-haiku-4-5

SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_API_BASE=https://connect.squareup.com

# LetterStream — Monetization Mode (master account)
LETTERSTREAM_API_ID=
LETTERSTREAM_API_KEY=
LETTERSTREAM_API_BASE=https://www.letterstream.com/apis/index.php
# test = jobs submitted but not auto-approved | production = real mail
LETTERSTREAM_MODE=production
LETTERSTREAM_CALLBACK_URL=https://app.disputeiq.org/api/webhooks/letterstream
# Optional shared-secret echoed back in the callback `key` field
LETTERSTREAM_CALLBACK_KEY=
# batch (Method 1 ZIP, default) | single (Method 2 single_file fallback)
LETTERSTREAM_SUBMIT_METHOD=batch

MFSN_API_KEY=
MFSN_AFFILIATE_LINK=
MFSN_CALLBACK_URL=https://app.disputeiq.org/api/mfsn/callback

# Cloudflare R2 (S3-compatible)
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com

OCR_API_KEY=
